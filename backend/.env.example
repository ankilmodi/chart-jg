# Nifty Future Analyzer – Backend Environment Variables
# Copy this file to .env and fill in values

# Server
HOST=0.0.0.0
PORT=8000

# Data refresh interval in seconds
REFRESH_INTERVAL_SECONDS=60

# CORS – comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: TwelveData free API key (backup data source)
# Get free key at https://twelvedata.com
TWELVEDATA_API_KEY=

# Optional: Alpha Vantage API key (second backup)
# Get free key at https://www.alphavantage.co
ALPHAVANTAGE_API_KEY=

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
