{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "CORS_ORIGINS": "http://localhost:5173,http://localhost:3000,https://brave-success-production-6aea.up.railway.app,https://frontend-ankilmodis-projects.vercel.app,https://frontend-ankilmodi-ankilmodis-projects.vercel.app,https://frontend-beta-lime-86.vercel.app"
  },
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  }
}
